# =================================================================
# GEMINI AI STUDIO DEFAULT SYSTEM VARIABLES
# =================================================================
# Required for Gemini AI API calls when Gemini is enabled.
# Set this value in your local environment or deployment secret store.
GEMINI_API_KEY=

# APP_URL: Public URL for the app, if used in deployment.
APP_URL=

# =================================================================
# SALIENCE ATLAS V2 — SECURITY & AUTHENTICATION
# =================================================================

# DEV_AUTH_BYPASS: Temporarily bypass the authentication gateway during development.
DEV_AUTH_BYPASS=false

# DEMO_DEV_PASSWORD: Shared demo identity password for the seeded Zero Trust
# identities (kamau@ketraco.co.ke, ndegwa@kengen.co.ke, kariuki@kplc.co.ke,
# board@ketraco.co.ke). When unset a documented local-dev fallback is used and
# a startup warning is emitted. Set a strong value in any shared environment.
DEMO_DEV_PASSWORD=password123

# =================================================================
# SALIENCE ATLAS V2 — AI FEDERATION ENVIRONMENT GOVERNANCE LAYER
# =================================================================

#################################################
# GEMINI
#################################################
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FALLBACK_PRIORITY=1

#################################################
# OPENROUTER
#################################################
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1
OPENROUTER_FALLBACK_PRIORITY=3

#################################################
# GROQ
#################################################
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-4-scout
GROQ_FALLBACK_PRIORITY=2

#################################################
# CEREBRAS
#################################################
CEREBRAS_ENABLED=false
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-4
CEREBRAS_FALLBACK_PRIORITY=4

#################################################
# OPENAI
#################################################
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_FALLBACK_PRIORITY=5

#################################################
# ANTHROPIC
#################################################
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus
ANTHROPIC_FALLBACK_PRIORITY=6

#################################################
# DEEPSEEK
#################################################
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FALLBACK_PRIORITY=7

#################################################
# TOGETHER AI
#################################################
TOGETHER_ENABLED=false
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama
TOGETHER_FALLBACK_PRIORITY=8

#################################################
# FIREWORKS
#################################################
FIREWORKS_ENABLED=false
FIREWORKS_API_KEY=
FIREWORKS_MODEL=llama
FIREWORKS_FALLBACK_PRIORITY=9

#################################################
# HUGGINGFACE
#################################################
HF_ENABLED=false
HF_API_KEY=
HF_MODEL=mistralai
HF_FALLBACK_PRIORITY=10

#################################################
# ALIBABA QWEN
#################################################
QWEN_ENABLED=false
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen-max
QWEN_FALLBACK_PRIORITY=11

#################################################
# ZHIPU AI (GLM)
#################################################
ZHIPU_ENABLED=false
ZHIPU_API_KEY=
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-4-plus
ZHIPU_FALLBACK_PRIORITY=12

#################################################
# MOONSHOT (KIMI)
#################################################
MOONSHOT_ENABLED=false
MOONSHOT_API_KEY=
MOONSHOT_API_BASE=https://api.moonshot.cn/v1/chat/completions
MOONSHOT_MODEL=moonshot-v1-128k
MOONSHOT_FALLBACK_PRIORITY=13

#################################################
# MINIMAX
#################################################
MINIMAX_ENABLED=false
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.chat/v1/text/chatcompletion_v2
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_FALLBACK_PRIORITY=14

#################################################
# LOCAL vLLM / SGLang / llama.cpp (Enterprise AI Cluster)
#################################################
# vLLM OpenAI-compatible inference server
VLLM_ENABLED=false
VLLM_API_BASE=http://localhost:8000/v1/chat/completions
VLLM_MODEL=qwen-72b
VLLM_FALLBACK_PRIORITY=998

# SGLang OpenAI-compatible inference server
SGLANG_ENABLED=false
SGLANG_API_BASE=http://localhost:30000/v1/chat/completions
SGLANG_MODEL=deepseek-v3
SGLANG_FALLBACK_PRIORITY=997

# llama.cpp OpenAI-compatible inference server
LLAMACPP_ENABLED=false
LLAMACPP_API_BASE=http://localhost:8080/v1/chat/completions
LLAMACPP_MODEL=llama-3-8b
LLAMACPP_FALLBACK_PRIORITY=996

#################################################
# LOCAL OLLAMA
#################################################
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_FALLBACK_PRIORITY=999

#################################################
# PROVIDER HEALTH OVERRIDES
#################################################
FORCE_PROVIDER=

#################################################
# COST GOVERNANCE ENV VARIABLES
#################################################
AI_MONTHLY_BUDGET_USD=100
AI_DAILY_BUDGET_USD=10
AI_REQUEST_LIMIT_PER_MINUTE=500
AI_MAX_RETRIES=3
AI_MAX_AGENT_DEPTH=20
AI_MAX_CONCURRENT_WORKFLOWS=100

#################################################
# TELEMETRY ENV VARIABLES
#################################################
ENABLE_AI_TELEMETRY=true
ENABLE_AI_AUDIT_LOGGING=true
ENABLE_PROVIDER_HEALTH_MONITORING=true
ENABLE_COST_TRACKING=true

#################################################
# CACHING CONFIGURATION
#################################################
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=3600
AI_CACHE_BACKEND=memory

#################################################
# SECURITY CONTROLS
#################################################
ENABLE_SECRET_ROTATION=true
SECRET_ROTATION_DAYS=30
ENABLE_PROVIDER_ISOLATION=true

#################################################
# ENTERPRISE REDIS PLATFORM
#################################################
REDIS_ENABLED=true
REDIS_URL=
REDIS_ENVIRONMENT=development
REDIS_KEY_PREFIX=atlas
REDIS_TLS=false
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
